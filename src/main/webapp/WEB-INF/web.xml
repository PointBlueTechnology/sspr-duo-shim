<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0" metadata-complete="true">

    <display-name>sspr-duo-shim</display-name>

    <listener>
        <listener-class>duoshim.ShimContextListener</listener-class>
    </listener>

    <filter>
        <filter-name>securityHeaders</filter-name>
        <filter-class>duoshim.web.SecurityHeadersFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>securityHeaders</filter-name>
        <url-pattern>/*</url-pattern>
        <!-- Also on container error pages (error.html), not just normal requests. -->
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>

    <servlet>
        <servlet-name>sign</servlet-name>
        <servlet-class>duoshim.servlet.SignServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>grant</servlet-name>
        <servlet-class>duoshim.servlet.GrantServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>token</servlet-name>
        <servlet-class>duoshim.servlet.TokenServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>userinfo</servlet-name>
        <servlet-class>duoshim.servlet.UserInfoServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>startOver</servlet-name>
        <servlet-class>duoshim.servlet.StartOverServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>health</servlet-name>
        <servlet-class>duoshim.servlet.HealthServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>duoCallback</servlet-name>
        <servlet-class>duoshim.servlet.DuoCallbackServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>sign</servlet-name>
        <url-pattern>/oauth/sign</url-pattern>
    </servlet-mapping>
    <!-- SSPR 4.5 derives /sign by replacing "/grant"; SSPR 4.8 by cutting at the last "/auth". -->
    <servlet-mapping>
        <servlet-name>grant</servlet-name>
        <url-pattern>/oauth/grant</url-pattern>
        <url-pattern>/oauth/auth</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>token</servlet-name>
        <url-pattern>/oauth/token</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>userinfo</servlet-name>
        <url-pattern>/oauth/userinfo</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>startOver</servlet-name>
        <url-pattern>/oauth/startover</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>health</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>duoCallback</servlet-name>
        <url-pattern>/duo/callback</url-pattern>
    </servlet-mapping>

    <!-- No sessions: state lives in the shim's own stores. -->
    <session-config>
        <session-timeout>1</session-timeout>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Plain error responses, no stack traces. -->
    <error-page>
        <location>/error.html</location>
    </error-page>
</web-app>
